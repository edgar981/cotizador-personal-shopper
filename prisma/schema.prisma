// Cotizador Personal Shopper — esquema v1
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Dominio
// ---------------------------------------------------------------------------

/// Singleton de configuración (una sola fila, id fijo "config").

model Settings {
  id              String   @id @default("config")
  margen_pct      Float // margen sobre costo aterrizado en COP. TODO(cliente)
  tarifa_lb_usd   Float // tarifa del casillero por libra. TODO(cliente)
  sales_tax_pct   Float // sales tax US estimado. TODO(cliente)
  trm_buffer_pct  Float // colchón sobre la TRM oficial. TODO(cliente)
  redondeo_cop    Int // redondear el precio final hacia arriba a múltiplos de este valor
  /// Porción del MARGEN que se va en comisión, en fracción (0.1 = 10%).
  /// TODO(cliente). No toca `precio_cop`: reparte lo que la cotización ya deja.
  comision_pct    Float    @default(0.1)
  pesos_categoria Json // { "tenis": 2.6, "perfume": 1.1, ... } en libras. TODO(cliente)
  /// Tramo nacional Bogotá → destino final, normalmente Interrapidísimo:
  /// [{ nombre, tarifa_base_cop, adicional_lb_cop }]. TODO(cliente).
  ///
  /// OJO — esta columna tiene TRES estados con significado distinto, y el
  /// `?` es semántico, no un descuido. `null` y `[]` NO son lo mismo:
  ///
  ///   null      → la fila es anterior a esta feature (la migración solo
  ///               agregó la columna, sin backfill). Se muestran las zonas de
  ///               referencia para que haya algo editable de entrada.
  ///   []        → la usuaria borró todas las zonas a propósito. Se respeta:
  ///               el estimador queda apagado y el selector no aparece.
  ///   [ ...  ]  → tabla activa; es la que se usa para cotizar.
  ///
  /// Si algún día se hace backfill de `null` a `[]`, o se pone la columna como
  /// NOT NULL con default `[]`, se pierde la diferencia entre "nunca se
  /// configuró" y "se desactivó": las filas viejas dejarían de mostrar zonas y
  /// el estimador desaparecería sin que nadie lo haya apagado.
  ///
  /// La lógica vive en `normalizarZonas()` (lib/settings-defaults.ts) y está
  /// cubierta por los tests de lib/envio.test.ts.
  zonas_envio     Json?
  ig_handle       String // @usuario de Instagram de la tienda
  lema            String   @default("De USA a tu puerta")
  color_marca     String // hex, para la plantilla de historia
  updatedAt       DateTime @updatedAt
}

model Cotizacion {
  id               String  @id @default(cuid())
  url              String
  nombre           String
  imagen_url       String? // URL de la imagen original del retailer (hotlink, camino por URL)
  captura_url      String? // URL en Blob de la captura subida (camino por captura)
  /// "url" | "captura" — de dónde salieron los datos de esta cotización.
  imagen_origen    String  @default("url")
  /// Recuadro de la foto del producto dentro de la captura, en fracciones
  /// 0..1: { x, y, ancho, alto }. Null = usar la captura completa.
  recorte          Json?
  /// Foto puesta a mano para la historia. Reemplaza a la captura solo como
  /// asset visual; `captura_url` se conserva intacta como evidencia.
  historia_url     String?
  /// Recuadro dentro de `historia_url`, mismo formato que `recorte`.
  historia_recorte Json?
  categoria        String
  talla_notas      String?
  precio_usd       Float
  peso_lb          Float

  /// Estimado del tramo nacional al momento de guardar. Es una referencia
  /// aparte: NO entra en `costo_cop`, `margen_cop` ni `precio_cop`, y no
  /// aparece en la historia.
  zona_envio         String?
  envio_nacional_cop Int?

  /// Reparto del margen al momento de cotizar. Derivadas de `margen_cop`, no
  /// de `precio_cop`, y nunca aparecen en la historia: son internas.
  /// `Float` como `margen_cop` (y no `Int` como el envío) para que
  /// `comision_cop + margen_neto_cop` sume exactamente `margen_cop`.
  comision_cop    Float?
  margen_neto_cop Float?

  // Snapshot del cálculo al momento de cotizar (nunca recalcular histórico)
  tax_usd      Float
  flete_usd    Float
  trm_oficial  Float
  trm_aplicada Float
  costo_cop    Float
  margen_cop   Float
  precio_cop   Int
  desglose     Json // copia completa de parámetros usados (auditoría)

  createdAt DateTime @default(now())

  /// Personas que pidieron este producto. Una cotización es un producto
  /// publicado; cada encargo es una clienta pidiéndolo en su talla y para su
  /// destino. Por eso la cotización nunca se duplica.
  encargos Encargo[]

  @@index([createdAt])
}

/// Una clienta pidiendo un producto ya cotizado, con su talla y su destino.
///
/// El dato existe desde el día que se confirma la compra; antes se reconstruía
/// por WhatsApp semanas después, cuando los paquetes ya estaban en Bogotá.
model Encargo {
  id           String     @id @default(cuid())
  cotizacionId String
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id])

  /// Datos de la clienta embebidos, sin tabla `Cliente` aparte: todavía no hay
  /// evidencia de que se necesite historial por persona, y una tabla prematura
  /// obliga a resolver deduplicación de nombres que nadie pidió. Si aparece la
  /// necesidad, se extrae.
  cliente_nombre String
  cliente_tel    String?
  cliente_notas  String?

  // Qué pidió
  talla    String?
  color    String?
  /// `precio_cop` es por unidad; el total se deriva multiplicando por esto.
  cantidad Int     @default(1)

  /// "bogota" | "san_marcos" | "otra_ciudad". A San Marcos no se despacha uno
  /// por uno: se espera el lote completo. Por eso el destino es un tipo y no
  /// solo una dirección de texto.
  destino_tipo   String
  /// Requerida cuando `destino_tipo` = "otra_ciudad".
  destino_ciudad String?
  destino_dir    String?

  /// Snapshot del momento de confirmar, igual que todo lo demás en esta app: si
  /// la cotización se regenera con otra TRM, el encargo conserva lo que se le
  /// prometió a la clienta.
  precio_cop Int
  envio_cop  Int?
  abono_cop  Int?

  /// confirmado → comprado → en_casillero → en_bogota → despachado → entregado,
  /// más "cancelado" como estado terminal alterno. Se avanza y se retrocede a
  /// mano: en la operación real las cosas se devuelven y se corrigen, así que
  /// NO hay máquina de estados rígida. Cancelar es un estado, nunca un delete.
  estado String @default("confirmado")

  /// Número de guía de la transportadora, si aplica.
  guia  String?
  notas String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Marca de tiempo por estado, para saber cuánto lleva cada cosa. Se reescribe
  /// cada vez que el encargo entra al estado (corregir un cambio equivocado deja
  /// la fecha buena); retroceder no borra las marcas ya escritas.
  /// `confirmado` no tiene columna: `createdAt` ya lo dice.
  comprado_at     DateTime?
  en_casillero_at DateTime?
  en_bogota_at    DateTime?
  despachado_at   DateTime?
  entregado_at    DateTime?
  cancelado_at    DateTime?

  /// Pensados para el tablero de despacho (agrupar por destino y estado).
  @@index([estado])
  @@index([destino_tipo, estado])
  @@index([cotizacionId])
}

/// Caché diario de la TRM oficial (datos.gov.co). La fila más reciente sirve
/// de respaldo cuando la API pública falla.

model TrmCache {
  dia       String   @id // día de consulta en Bogotá, "YYYY-MM-DD"
  valor     Float
  vigencia  String // vigenciadesde de la TRM devuelta por datos.gov.co
  fetchedAt DateTime @default(now())
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
